{"header":{"type":"esummary","version":"0.3"},"result":{"uids":["213"],"213":{"uid":"213","name":"ALB","description":"albumin","status":"","currentid":"","chromosome":"4","geneticsource":"genomic","maplocation":"4q13.3","otheraliases":"FDAHT, HSA, PRO0883, PRO0903, PRO1341","otherdesignations":"albumin|serum albumin","nomenclaturesymbol":"ALB","nomenclaturename":"albumin","nomenclaturestatus":"Official","mim":["103600"],"genomicinfo":[{"chrloc":"4","chraccver":"NC_000004.12","chrstart":73404286,"chrstop":73421481,"exoncount":15}],"geneweight":34276,"summary":"This gene encodes the most abundant protein in human blood. This protein functions in the regulation of blood plasma colloid osmotic pressure and acts as a carrier protein for a wide range of endogenous molecules including hormones, fatty acids, and metabolites, as well as exogenous drugs. Additionally, this protein exhibits an esterase-like activity with broad substrate specificity. The encoded preproprotein is proteolytically processed to generate the mature protein. A peptide derived from this protein, EPI-X4, is an endogenous inhibitor of the CXCR4 chemokine receptor. [provided by RefSeq, Jul 2016]","chrsort":"04","chrstart":73404286,"organism":{"scientificname":"Homo sapiens","commonname":"human","taxid":9606},"locationhist":[{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73404286,"chrstop":73421481},{"annotationrelease":"RS_2025_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":76747988,"chrstop":76765184},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73404286,"chrstop":73421481},{"annotationrelease":"RS_2024_08","assemblyaccver":"GCF_009914755.1","chraccver":"NC_060928.1","chrstart":76747988,"chrstop":76765184},{"annotationrelease":"RS_2023_10","assemblyaccver":"GCF_000001405.40","chraccver":"NC_000004.12","chrstart":73404286,"chrstop":73421481},{"annotation